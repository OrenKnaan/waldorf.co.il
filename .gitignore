# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# Wrangler's local secrets file. `wrangler dev` reads it instead of the real
# Worker secrets, so it is where an API token ends up while testing. This repo
# is public: committing one publishes it, and deleting it later does not.
.dev.vars
.dev.vars.*

# `wrangler dev --local` state: the local D1 database and its caches.
.wrangler/

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# local Claude Code config/skills - not part of the site
/.claude/
# Serena MCP project cache - not part of the site
/.serena/

# local working backups - not part of the site
/mockup backup/
*.zip
# scratch downloads (source art lands in mockup/assets/art/ once chosen)
/temp/

# internal business docs (pricing proposals, contracts, private notes) -
# not meant for the public repo
/docs/
/archive/
/*.pdf
*.docx
/Rav Messer API.txt

# wrangler build output
/analytics-worker/.wrangler/
